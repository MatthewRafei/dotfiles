            if name.startswith("org.pwmt.zathura.PID-"):
                subprocess.run(["busctl", "--user", "call", name, "/org/pwmt/zathura",
                                "org.pwmt.zathura", "ExecuteCommand", "s", "source"],
                               capture_output=True, timeout=3)
    except Exception:
        pass


CHROMIUM_PREFS = os.path.join(CFG, "chromium", "Default", "Preferences")


def chromium_running():
    return subprocess.run(["pgrep", "-x", "chromium"], capture_output=True).returncode == 0


CHROMIUM_POLICY_DIR = "/etc/chromium/policies/managed"


def write_chromium(p):
    """Theme Chromium with the accent colour.

    Preferred: the BrowserThemeColor policy, which a running Chromium
    reloads by itself. Needs /etc/chromium/policies/managed to be writable by
    this user (one-time: doas install -d -o $USER /etc/chromium/policies/managed).

    Fallback: the "Customize Chrome" colour in the profile's Preferences.
    Chromium rewrites Preferences on exit, so that only works while it's
    closed; ~/.local/bin/chromium re-applies it at every launch.
    """
    if os.access(CHROMIUM_POLICY_DIR, os.W_OK):
        # a running Chromium watches this folder and picks the change up by
        # itself within seconds. (It used to be poked with
        # --refresh-platform-policy, but racing a Chromium that was starting
        # or closing made it shut down.)
        write(os.path.join(CHROMIUM_POLICY_DIR, "wallpaper-theme.json"),
              json.dumps({"BrowserThemeColor": p["accent"]}) + "\n")
        return
    if not os.path.exists(CHROMIUM_PREFS) or chromium_running():
        return
    with open(CHROMIUM_PREFS) as f:
        prefs = json.load(f)
    argb = 0xFF000000 | int(p["accent"].lstrip("#"), 16)
    theme = prefs.setdefault("browser", {}).setdefault("theme", {})
    theme.update({
        "user_color2": argb - (1 << 32),   # SkColor as signed int32
        "color_variant2": 2 if p["mono"] else 1,   # neutral for mono, tonal spot otherwise
        "color_scheme2": 2,                # dark
        "is_grayscale2": bool(p["mono"]),
        "follows_system_colors": False,
    })
    prefs.setdefault("extensions", {}).setdefault("theme", {})["system_theme"] = 0  # not GTK
    write(CHROMIUM_PREFS, json.dumps(prefs, separators=(",", ":")))


STARSHIP_MARK = "# --- generated by ~/.config/theme/wallpaper-theme: do not edit below ---"


def write_starship(p):
    """Replace the [palettes.wallpaper] block at the end of starship.toml."""
    path = os.path.join(CFG, "starship.toml")
    if not os.path.exists(path):
        return
    with open(path) as f:
        text = f.read()
    if STARSHIP_MARK not in text:
        return
    a = p["ansi"]["normal"]
    block = "\n".join([
        STARSHIP_MARK,
        "[palettes.wallpaper]",
        f'accent = "{p["accent"]}"',
        f'accent2 = "{p["accent2"]}"',
        f'text = "{p["text"]}"',
        f'dim = "{p["textDim"]}"',
        f'faint = "{p["textFaint"]}"',
        f'border = "{p["borderAccent"]}"',
        f'frame = "{p["textFaint"]}"',
        f'danger = "{p["danger"]}"',
        f'yellow = "{a["yellow"]}"',
        f'magenta = "{a["magenta"]}"',
        "",
    ])
    write(path, text[:text.index(STARSHIP_MARK)] + block)


def edit_keys(path, sections):
    """Rewrite `key=value` lines in an ini-ish file.

    sections maps a section name ("" = before any header) to {key: value}.
    Only existing keys are changed; everything else is left untouched.
    """
    if not os.path.exists(path):
        return
    with open(path) as f:
        lines = f.read().split("\n")
    section = ""
    for i, line in enumerate(lines):
        st = line.strip()
        m = re.match(r"^\[(.+)\]$", st)
        if m:
            section = m.group(1)
            continue
        km = re.match(r"^([\w-]+)\s*=", st)
        if km and km.group(1) in sections.get(section, {}):
            lines[i] = "%s=%s" % (km.group(1), sections[section][km.group(1)])
    write(path, "\n".join(lines))


def write_fuzzel(p):
    x = lambda c, a="ff": c.lstrip("#") + a
    edit_keys(os.path.join(CFG, "fuzzel", "fuzzel.ini"), {
        "colors": {"background": x(p["bgPanel"], "f2"),
                   "text": x(p["textDim"]),
                   "prompt": x(p["accent"]),
                   "placeholder": x(p["textFaint"]),
                   "input": x(p["text"]),
                   "match": x(p["accent"]),
                   "selection": x(p["surface"]),
                   "selection-text": x(p["text"]),
                   "selection-match": x(p["accent"]),
                   "border": x(p["accent"], "99")},
    })


def write_niri(p):
    """Recolour focus-ring and border inside the top-level layout block.

    niri watches its config and reloads on change, so this applies live.
    """
    if not have("niri"):
        return
    path = os.path.join(CFG, "niri", "config.kdl")
    with open(path) as f:
        lines = f.read().split("\n")

    in_layout, block = False, None
    for i, line in enumerate(lines):
        if re.match(r"^layout\s*\{", line):
            in_layout = True
            continue
        if in_layout and re.match(r"^\}", line):
            break
        if not in_layout:
            continue
        m = re.match(r"^\s*(focus-ring|border)\s*\{", line)
        if m:
            block = m.group(1)
            continue
        if block and re.match(r"^\s*\}", line):
            block = None
            continue
        indent = re.match(r"^(\s*)", line).group(1)
        if block == "focus-ring":
            if re.match(r"^\s*active-gradient\b", line):
                lines[i] = f'{indent}active-gradient from="{p["accent"]}" to="{p["accent2"]}" angle=45'
            elif re.match(r"^\s*active-color\b", line):
                lines[i] = f'{indent}active-color "{p["accent"]}"'
            elif re.match(r"^\s*inactive-color\b", line):
                lines[i] = f'{indent}inactive-color "{p["border"]}"'
        elif block == "border":
            if re.match(r"^\s*active-color\b", line):
                lines[i] = f'{indent}active-color "{p["accent"]}"'
            elif re.match(r"^\s*inactive-color\b", line):
                lines[i] = f'{indent}inactive-color "{p["border"]}"'
            elif re.match(r"^\s*urgent-color\b", line):
                lines[i] = f'{indent}urgent-color "{p["danger"]}"'

    write(path, "\n".join(lines))


