#!/usr/bin/env python3
"""Generate a system colour theme from a wallpaper and apply it everywhere.

    wallpaper-theme [IMAGE]     theme from IMAGE (default: what awww is showing)
    wallpaper-theme --print     print the palette without applying it
    wallpaper-theme --chromium  re-apply the saved palette to Chromium only

Colours are pulled from the image with ImageMagick, normalised into a dark
theme (tinted backgrounds, readable accent, harmonised ANSI colours) and
written to:

    ~/.cache/theme/palette.json        read live by quickshell (Theme.qml)
    ~/.config/alacritty/colors.toml    imported by alacritty.toml (live reload)
    ~/.config/starship.toml            [palettes.wallpaper] block at the end
    ~/.config/niri/config.kdl          focus-ring / border colours (in place)
    ~/.config/hypr/colors.lua          border colours, required by hyprland.lua
    ~/.config/fuzzel/fuzzel.ini        [colors] keys (in place)
    ~/.config/gtk-{3,4}.0/gtk.css      libadwaita colours + Nautilus styling
    Papirus-Dark folder colour         nearest to the accent (papirus-folders)
    Chromium                           BrowserThemeColor policy (live) or Preferences
    ~/.config/fastfetch/config.jsonc   whole HUD layout
    ~/.config/mpv/theme.conf + script-opts/{osc,console}.conf
    ~/.config/zathura/colors            included by zathurarc; open windows reload it
    the mouse cursor                   cursor/cursor-accent (accent outline; Settings > Mouse)

A mostly greyscale wallpaper keeps the original monochrome look.
"""

import colorsys
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config")
CACHE = os.path.join(HOME, ".cache", "theme")


# ---------------------------------------------------------------- colour utils

def hex_to_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#" + "".join("%02x" % round(max(0, min(1, c)) * 255) for c in rgb)


def hls(h, l, s):
    return rgb_to_hex(colorsys.hls_to_rgb(h % 1.0, l, s))


def hue_dist(a, b):
    d = abs(a - b) % 1.0
    return min(d, 1 - d)


def hue_blend(a, b, t):
    """Move hue a toward hue b by fraction t along the short way round."""
    d = ((b - a + 0.5) % 1.0) - 0.5
    return (a + d * t) % 1.0


# ---------------------------------------------------------------- extraction

def extract(path):
    """Return [(count, (h, l, chroma))] for the image's dominant colours.

    Chroma (max - min channel) is used instead of HLS saturation, which is
    meaningless near black/white (#000001 reports s=1.0).
    """
    out = subprocess.run(
        ["magick", path + "[0]", "-resize", "200x200", "-colors", "24",
         "-depth", "8", "-format", "%c", "histogram:info:-"],
        capture_output=True, text=True, check=True,
    ).stdout
    colours = []
    for line in out.splitlines():
        m = re.match(r"\s*(\d+):.*?(#[0-9A-Fa-f]{6})", line)
        if m:
            r, g, b = hex_to_rgb(m.group(2))
            h, l, _ = colorsys.rgb_to_hls(r, g, b)
            colours.append((int(m.group(1)), (h, l, max(r, g, b) - min(r, g, b))))
    if not colours:
        raise SystemExit("wallpaper-theme: no colours extracted from " + path)
    return colours


def pick_accents(colours, bins=12):
    """Dominant vivid hue family, plus a second family elsewhere on the wheel.

    Colours are grouped into hue bins weighted by count * chroma^2, so many
    shades of the same hue add up and big dark/grey areas count for little.
    Returns (hue1, chroma1, hue2), or None for a greyscale image.
    """
    weight = [0.0] * bins
    members = [[] for _ in range(bins)]
    for count, (h, l, c) in colours:
        if c < 0.12 or l < 0.08 or l > 0.95:
            continue
        w = count * c * c
        b = int(h * bins) % bins
        weight[b] += w
        members[b].append((w, h, c))

    total = sum(count for count, _ in colours)
    if sum(weight) / total < 0.01:
        return None  # greyscale wallpaper

    def family(b):
        ws = sum(w for w, _, _ in members[b])
        # circular weighted mean of the hues in this bin
        ref = members[b][0][1]
        hue = (ref + sum(w * (((h - ref + 0.5) % 1.0) - 0.5) for w, h, _ in members[b]) / ws) % 1.0
        chroma = max(c for _, _, c in members[b])
        return hue, chroma

    order = sorted(range(bins), key=lambda b: weight[b], reverse=True)
    b1 = order[0]
    h1, c1 = family(b1)

    # second accent: strongest family at least two bins (~60°) away
    b2 = next((b for b in order[1:] if weight[b] > 0 and
               min((b - b1) % bins, (b1 - b) % bins) >= 2), None)
    h2 = family(b2)[0] if b2 is not None else (h1 + 0.09) % 1.0
    return h1, c1, h2


# ---------------------------------------------------------------- palette

def build_palette(colours, wallpaper):
    acc = pick_accents(colours)

    if acc is None:
        # Monochrome: the shell's original black/white look.
        h, s_bg = 0.0, 0.0
        accent, accent2 = "#ffffff", "#bfbfbf"
        tint = 0.0
        mono = True
    else:
        h, s_acc, h2 = acc
        s = min(0.85, max(0.5, s_acc))
        accent = hls(h, 0.70, s)
        accent2 = hls(h2, 0.72, min(0.8, s))
        s_bg = 0.28
        tint = 0.18
        mono = False

    p = {
        "wallpaper": wallpaper,
        "mono": mono,
        "accent": accent,
        "accent2": accent2,
        "accentFg": hls(h, 0.08, s_bg),
        "bgPanel": hls(h, 0.035, s_bg),
        "bg": hls(h, 0.06, s_bg),
        "bgCard": hls(h, 0.075, s_bg),
        "surface": hls(h, 0.12, s_bg * 0.9),
        "trackBg": hls(h, 0.10, s_bg * 0.8),
        "border": hls(h, 0.15, s_bg * 0.7),
        "borderAccent": hls(h, 0.22, s_bg * 0.7),
        "text": hls(h, 0.94, s_bg * 0.9),
        "textDim": hls(h, 0.60, s_bg * 0.5),
        "textFaint": hls(h, 0.34, s_bg * 0.5),
        "danger": hls(0.97, 0.62, 0.85),
        "ok": hls(0.42, 0.58, 0.75),
    }

    # ANSI: canonical hues nudged toward the accent hue so the terminal
    # feels related to the wallpaper while staying recognisable.
    base = {"red": 0.98, "green": 0.33, "yellow": 0.12,
            "blue": 0.60, "magenta": 0.85, "cyan": 0.49}
    sat = 0.55 if not mono else 0.35
    normal, bright = {}, {}
    for name, bh in base.items():
        hh = hue_blend(bh, h, tint)
        normal[name] = hls(hh, 0.68, sat)
        bright[name] = hls(hh, 0.77, sat + 0.1)
    normal["black"] = hls(h, 0.20, s_bg * 0.7)
    bright["black"] = hls(h, 0.34, s_bg * 0.6)
    normal["white"] = hls(h, 0.80, s_bg * 0.5)
    bright["white"] = hls(h, 0.94, s_bg * 0.6)
    p["ansi"] = {"normal": normal, "bright": bright}
    return p


# ---------------------------------------------------------------- writers

def have(cmd):
    return shutil.which(cmd) is not None


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def write_quickshell(p):
    write(os.path.join(CACHE, "palette.json"), json.dumps(p, indent=2) + "\n")


def write_alacritty(p):
    n, b = p["ansi"]["normal"], p["ansi"]["bright"]
    order = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    block = lambda d: "\n".join('%-7s = "%s"' % (k, d[k]) for k in order)
    write(os.path.join(CFG, "alacritty", "colors.toml"), f"""\
# Generated by ~/.config/theme/wallpaper-theme. Do not edit by hand.

