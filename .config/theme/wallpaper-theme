def write_icons(p):
    """Recolour Papirus folders to the nearest match for the accent."""
    tool = os.path.join(HOME, ".local", "bin", "papirus-folders")
    if not os.path.exists(tool) or not os.path.isdir(os.path.join(HOME, ".local/share/icons/Papirus-Dark")):
        return
    if p["mono"]:
        colour = "grey"
    else:
        ah, al, _ = colorsys.rgb_to_hls(*hex_to_rgb(p["accent"]))

        def dist(item):
            h, l, s = colorsys.rgb_to_hls(*hex_to_rgb(item[1]))
            return hue_dist(h, ah) * 4 + abs(l - al) + (0.5 if s < 0.25 else 0)

        colour = min(PAPIRUS_FOLDERS.items(), key=dist)[0]

    state = os.path.join(CACHE, "papirus-folders")
    try:
        with open(state) as f:
            if f.read().strip() == colour:
                return
    except OSError:
        pass
    r = subprocess.run([tool, "-C", colour, "--theme", "Papirus-Dark"],
                       capture_output=True, text=True)
    if r.returncode == 0:
        write(state, colour + "\n")
    else:
        print("wallpaper-theme: papirus-folders failed: " + (r.stderr or r.stdout).strip(),
              file=sys.stderr)


def write_gsettings(p):
    """GTK4/libadwaita apps on Wayland take the icon theme and dark mode from
    GSettings, not settings.ini, so mirror settings.ini there. Without this
    Nautilus shows Adwaita's blue folders instead of the recoloured Papirus."""
    if not have("gsettings"):
        return
    iface = "org.gnome.desktop.interface"
    # gtk-theme covers GTK3 and plain GTK4 apps; libadwaita ones use color-scheme
    wanted = {"color-scheme": "prefer-dark", "gtk-theme": "Adwaita-dark"}
    if os.path.isdir(os.path.join(HOME, ".local/share/icons/Papirus-Dark")):
        wanted["icon-theme"] = "Papirus-Dark"
    for key, value in wanted.items():
        subprocess.run(["gsettings", "set", iface, key, value], capture_output=True)


# ---------------------------------------------------------------- main

def current_wallpaper():
    out = subprocess.run(["awww", "query"], capture_output=True, text=True).stdout
    m = re.search(r"image: (.*)$", out, re.M)
    if not m:
        raise SystemExit("wallpaper-theme: no image given and awww shows none")
    return m.group(1).strip()


def main():
    args = sys.argv[1:]
    if "--chromium" in args:
        with open(os.path.join(CACHE, "palette.json")) as f:
            write_chromium(json.load(f))
        return
    dry = "--print" in args
    args = [a for a in args if a != "--print"]
    image = os.path.abspath(os.path.expanduser(args[0])) if args else current_wallpaper()

    palette = build_palette(extract(image), image)

    if dry:
        print(json.dumps(palette, indent=2))
        return

    for writer in (write_quickshell, write_alacritty, write_niri, write_hyprland,
                   write_fuzzel, write_gtk, write_icons, write_gsettings,
                   write_starship, write_chromium, write_fastfetch,
                   write_mpv, write_zathura, write_cursor):
        try:
            writer(palette)
        except Exception as e:  # one broken target shouldn't stop the rest
            print(f"wallpaper-theme: {writer.__name__} failed: {e}", file=sys.stderr)

    print(f"wallpaper-theme: {palette['accent']} / {palette['accent2']}"
          f"{' (mono)' if palette['mono'] else ''} from {os.path.basename(image)}")


if __name__ == "__main__":
    main()
